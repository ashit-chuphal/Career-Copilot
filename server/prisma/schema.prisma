generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  email      String     @id
  firstName  String
  lastName   String
  createdAt  DateTime   @default(now())
  password   String?
  provider   String     @default("local")
  googleId   String?
  profilePic String?
  analyses   Analysis[]
}

model Analysis {
  id             String   @id @default(uuid())
  jobDescription String
  createdAt      DateTime @default(now())
  userEmail      String
  result         Json
  user           User     @relation(fields: [userEmail], references: [email])

  @@index([userEmail])
}
